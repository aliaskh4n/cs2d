    "MAX_STORAGE_BYTES": "536870912"
  },
  "durable_objects": { "bindings": [{ "name": "LIBRARY", "class_name": "CloudLibrary" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CloudLibrary"] }]
}
